<Project>
  <!--
    Directory.Build.props - Impostazioni comuni per tutti i progetti nella solution
    Questo file viene automaticamente incluso da MSBuild in tutti i progetti
  -->

  <PropertyGroup>
    <!-- .NET Settings -->
    <TargetFramework>net11.0</TargetFramework>
    <!-- LangVersion non impostata: il default del compilatore segue il TFM (C# 15 su net11.0) -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Code Quality: a alzare il livello del lint (dotnet format con verify-no-changes) su codice esistente sono EnforceCodeStyleInBuild, AnalysisLevel e GenerateDocumentationFile; TreatWarningsAsErrors resta false -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Assembly Info: nessun valore di default. Se servono, impostali nel progetto host, ad esempio:
         <Authors>Nome Azienda</Authors>
         <Company>Nome Azienda</Company>
         <Copyright>© Nome Azienda. All rights reserved.</Copyright>
         <Product>Nome Prodotto</Product>
    -->

    <!-- Versioning -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>

    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn> <!-- Disable warning for missing XML comments -->
  </PropertyGroup>

  <!-- Debug Configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <!-- Release Configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Common Package References (se applicabili a tutti i progetti) -->
  <!--
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  -->

</Project>
